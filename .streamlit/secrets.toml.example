# Copia questo file in .streamlit/secrets.toml e inserisci i valori reali.
# (su Streamlit Cloud: Settings -> Secrets, incolla lo stesso contenuto)

CARTO_KEY = ""   # opzionale

# Connessione al database Supabase (vedi docs/supabase_setup.md).
# Usa la stringa "Session pooler" di Supabase, NON quella "Direct connection".
[supabase]
url = "postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGIONE.pooler.supabase.com:5432/postgres"
